# Copy to /home/pi/flotsam/uploader.env and fill in the bucket.
# Bucket = the "Bucket" output of the buoy-monitor CloudFormation stack (aws/template.yaml).
FLOTSAM_BUCKET=
AWS_REGION=us-east-2
FLOTSAM_PREFIX=images/
FLOTSAM_IMAGES=/home/pi/flotsam-images
# Credentials: put a key for an S3 PutObject-only identity in /home/pi/.aws/credentials
# (profile "default", or set AWS_PROFILE=... here).
FLOTSAM_READINGS_PREFIX=readings/
