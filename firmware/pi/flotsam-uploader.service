[Unit]
Description=Flotsam: upload camera images from the shore Pi to S3
After=network-online.target
Wants=network-online.target

[Service]
User=pi
EnvironmentFile=/home/pi/flotsam/uploader.env
ExecStart=/usr/bin/python3 /home/pi/flotsam/firmware/upload_s3.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
