CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_BRIDGE_DATA_FORWARDING_NETIF_SOFTAP=y
CONFIG_BRIDGE_EXTERNAL_NETIF_STATION=y
CONFIG_BRIDGE_SOFTAP_SSID="Flotsam"
CONFIG_BRIDGE_SOFTAP_PASSWORD=""
CONFIG_BRIDGE_SOFTAP_MAX_CONNECT_NUMBER=5
CONFIG_MESH_LITE_ENABLE=y
CONFIG_MESH_LITE_ID=77
CONFIG_MESH_LITE_MAXIMUM_LEVEL_ALLOWED=5
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
